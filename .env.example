# postgres
PG_USER=     # OS username
PG_PASSWORD= # required for docker compose
PG_HOST=localhost
PG_PORT=5432
PG_NAME=bolobao

GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://<PG_USER>:<PG_PASSWORD>@localhost:<PG_PORT>/bolobao?sslmode=disable
GOOSE_MIGRATION_DIR=./internal/database/migrations

# go server: optional, will use defaults
PORT= # 8080
WRITER_ADDR= # http://localhost:8000

# pipeline
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
S3_BUCKET=
S3_BUCKET_PHOTOS=

FSQ_TOKEN=
TAVILY_KEY=
NEBIUS_KEY=

SHAM_SHUI_PO_PLACES_KEY= # places/sham-shui-po-2026-09-15.parquet
HK_PLACES_KEY= # places/hk-2026-10-26.parquet
